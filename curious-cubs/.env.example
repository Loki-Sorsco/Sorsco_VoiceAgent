# ── Admin login ──────────────────────────────────────────────
# Password for the /admin panel. CHANGE THIS in production.
ADMIN_PASSWORD=curiouscubs@2026

# ── Contact form email (Resend) ──────────────────────────────
# Get a free API key at https://resend.com (100 emails/day free).
# Without a key, submissions are still saved and visible in /admin,
# just not emailed.
RESEND_API_KEY=
# Where contact form submissions are delivered:
CONTACT_TO_EMAIL=dev@sorsco.in
# Sender. "onboarding@resend.dev" works out of the box on Resend's
# free tier; switch to your verified domain later.
CONTACT_FROM_EMAIL=Curious Cubs <onboarding@resend.dev>

# ── Persistent storage (Upstash Redis / Vercel KV) ───────────
# On Vercel: Marketplace → Upstash Redis (free tier) and these are
# injected automatically. Locally you can leave them empty — data
# is kept in .data/db.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV legacy names also supported)
KV_REST_API_URL=
KV_REST_API_TOKEN=
